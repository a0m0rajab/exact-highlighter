{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "scopeName": "markdown.contract.codeblock",
  "injectionSelector": "L:text.html.markdown",
  "patterns": [
    { "include": "#contract-test-block" },
    { "include": "#contract-block" }
  ],
  "repository": {
    "contract-block": {
      "begin": "(^|\\G)(\\s*)(`{3,}|~{3,})\\s*(contract)\\s*$",
      "beginCaptures": {
        "3": { "name": "punctuation.definition.markdown" },
        "4": { "name": "fenced_code.block.language.markdown" }
      },
      "end": "(^|\\G)(\\2|\\s{0,3})(\\3)\\s*$",
      "endCaptures": {
        "3": { "name": "punctuation.definition.markdown" }
      },
      "name": "markup.fenced_code.block.markdown",
      "patterns": [
        {
          "begin": "(^|\\G)(\\s*)(.*)",
          "while": "(^|\\G)(?!\\s*([`~]{3,})\\s*$)",
          "contentName": "meta.embedded.block.contract",
          "patterns": [{ "include": "source.contract" }]
        }
      ]
    },
    "contract-test-block": {
      "begin": "(^|\\G)(\\s*)(`{3,}|~{3,})\\s*(contract-test)\\s*$",
      "beginCaptures": {
        "3": { "name": "punctuation.definition.markdown" },
        "4": { "name": "fenced_code.block.language.markdown" }
      },
      "end": "(^|\\G)(\\2|\\s{0,3})(\\3)\\s*$",
      "endCaptures": {
        "3": { "name": "punctuation.definition.markdown" }
      },
      "name": "markup.fenced_code.block.markdown",
      "patterns": [
        {
          "begin": "(^|\\G)(\\s*)(.*)",
          "while": "(^|\\G)(?!\\s*([`~]{3,})\\s*$)",
          "contentName": "meta.embedded.block.contract-test",
          "patterns": [{ "include": "source.contract-test" }]
        }
      ]
    }
  }
}
