{
  "comments": {
    "lineComment": "//"
  },
  "brackets": [
    ["(", ")"],
    ["[", "]"],
    ["{", "}"]
  ],
  "autoClosingPairs": [
    { "open": "(", "close": ")" },
    { "open": "[", "close": "]" },
    { "open": "{", "close": "}" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] },
    { "open": "`", "close": "`", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [
    ["(", ")"],
    ["[", "]"],
    ["{", "}"],
    ["\"", "\""],
    ["`", "`"]
  ],
  "wordPattern": "[A-Za-z_][A-Za-z0-9_]*(?:-[A-Za-z][A-Za-z0-9_]*)*|-?\\d+(?:\\.\\d+)?",
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(component|shape|style|routes|members|test|view|props|inject|provide|action|task|sequence|keyframes|theme|if|else|for|case|match)\\b.*$",
    "decreaseIndentPattern": "^\\s*else\\b"
  },
  "folding": {
    "offSide": true
  },
  "onEnterRules": []
}
