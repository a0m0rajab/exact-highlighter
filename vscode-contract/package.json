{
  "name": "exact-contract",
  "displayName": "Exact Contract",
  "description": "Syntax highlighting for Exact's Contract language (.contract and .test.contract files).",
  "version": "0.1.2",
  "publisher": "exact-community",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/expo/exact"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "exact",
    "contract",
    "expo",
    "syntax"
  ],
  "contributes": {
    "languages": [
      {
        "id": "contract",
        "aliases": [
          "Contract",
          "contract"
        ],
        "extensions": [
          ".contract"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "contract-test",
        "aliases": [
          "Contract Test",
          "contract-test"
        ],
        "filenamePatterns": [
          "*.test.contract"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "contract",
        "scopeName": "source.contract",
        "path": "./syntaxes/contract.tmLanguage.json"
      },
      {
        "language": "contract-test",
        "scopeName": "source.contract-test",
        "path": "./syntaxes/contract-test.tmLanguage.json"
      },
      {
        "scopeName": "markdown.contract.codeblock",
        "path": "./syntaxes/contract-markdown.tmLanguage.json",
        "injectTo": [
          "text.html.markdown"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.contract": "contract",
          "meta.embedded.block.contract-test": "contract-test"
        }
      }
    ],
    "configurationDefaults": {
      "editor.tokenColorCustomizations": {
        "[Visual Studio Dark]": {
          "textMateRules": [
            {
              "scope": [
                "entity.name.type.contract",
                "entity.name.type.component.contract",
                "entity.name.type.style.contract",
                "entity.name.type.constructor.contract",
                "support.type.primitive.contract",
                "support.type.contract"
              ],
              "settings": {
                "foreground": "#4EC9B0"
              }
            },
            {
              "scope": [
                "entity.name.function.contract",
                "entity.name.function.member.contract",
                "support.function.contract",
                "support.function.option.contract"
              ],
              "settings": {
                "foreground": "#DCDCAA"
              }
            },
            {
              "scope": [
                "variable.other.property.contract",
                "variable.other.definition.contract",
                "variable.other.readwrite.contract"
              ],
              "settings": {
                "foreground": "#9CDCFE"
              }
            },
            {
              "scope": [
                "punctuation.separator.type-annotation.contract"
              ],
              "settings": {
                "foreground": "#569CD6"
              }
            }
          ]
        },
        "[Visual Studio Light]": {
          "textMateRules": [
            {
              "scope": [
                "entity.name.type.contract",
                "entity.name.type.component.contract",
                "entity.name.type.style.contract",
                "entity.name.type.constructor.contract",
                "support.type.primitive.contract",
                "support.type.contract"
              ],
              "settings": {
                "foreground": "#267F99"
              }
            },
            {
              "scope": [
                "entity.name.function.contract",
                "entity.name.function.member.contract",
                "support.function.contract",
                "support.function.option.contract"
              ],
              "settings": {
                "foreground": "#795E26"
              }
            },
            {
              "scope": [
                "variable.other.property.contract",
                "variable.other.definition.contract",
                "variable.other.readwrite.contract"
              ],
              "settings": {
                "foreground": "#001080"
              }
            },
            {
              "scope": [
                "punctuation.separator.type-annotation.contract"
              ],
              "settings": {
                "foreground": "#0000FF"
              }
            }
          ]
        }
      }
    }
  },
  "scripts": {
    "test": "bun test/tokenize.test.mjs",
    "package": "bunx @vscode/vsce package --no-dependencies"
  },
  "devDependencies": {
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.2.0"
  }
}
